# Cấu hình mẫu Google Ads Campaign Auto Generator
# Đổi tên file này thành .env hoặc nhập trực tiếp trên giao diện ứng dụng

# Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình WooCommerce REST API
WP_URL=https://your-domain.com
WP_USER=your_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Cấu hình mặc định
DEFAULT_CAMPAIGN_NAME=Chiến dịch sản phẩm Web | 22/10
MAX_CPC=2000
ROOT_IMAGES_DIR=output/images
